# ==============================================================================
# CanteenHub - Environment Variables Configuration
# Copy this file to .env and adjust variables for your target environment.
# ==============================================================================

# Application Environment (dev, staging, prod)
APP_ENV=prod

# Database Configuration
DB_NAME=canteen_db
DB_USER=canteen_user
DB_PASSWORD=canteen_secure_pass123
DB_ROOT_PASSWORD=root_secure_pass123
DB_PORT=3306

# Backend Configuration
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=prod
LOG_LEVEL_CANTEEN=INFO
LOG_LEVEL_SPRING=INFO

# Security & JWT (Replace with a secure 256-bit+ random base64 string in production!)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000,http://127.0.0.1

# Frontend Configuration
FRONTEND_PORT=80
VITE_API_BASE_URL=/api
